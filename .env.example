# DocuBrowse — local dev/test environment (EXAMPLE)
#
# Copy this to `.env` (which is gitignored) and set your own local paths.
# These variables are used ONLY by the local dev/test scripts — never by the
# product at runtime. The app itself always reads its document directories from
# docubrowse.config / the Settings UI (which supports multiple local or remote
# folders); it never assumes any path.
#
# Nothing auto-loads .env for the plain `python3 test_*.py` scripts, so either
# export these in your shell or source the file first, e.g.:
#     set -a; . ./.env; set +a
#     python3 test_theme_responsive.py

# Real SQLite DB for test_theme_responsive.py.
# Unset -> falls back to ./test_docs.db
DOCUBROWSE_TEST_DB=/path/to/your/test_docs.db

# Where test_theme_responsive.py writes its report.
# Unset -> falls back to ./PHASE3_C_REPORT.txt
DOCUBROWSE_TEST_REPORT=./PHASE3_C_REPORT.txt
