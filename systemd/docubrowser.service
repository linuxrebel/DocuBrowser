# Reference template for a system-wide install at /opt/docubrowser.
# NOTE: the tarball installer (`install.sh`, system mode) GENERATES the actual
# unit at /etc/systemd/system/docubrowser.service with the real install dir,
# venv, service user, and port substituted in — you do not normally edit this
# file. It is kept here only as a manual-setup reference. Adjust the User/Group,
# paths, and port to your install before using it directly.

[Unit]
Description=DocuBrowse search server
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=docubrowser
Group=docubrowser
WorkingDirectory=/opt/docubrowser
ExecStart=/opt/docubrowser/venv/bin/python3 /opt/docubrowser/doc_search.py /opt/docubrowser/du-docs.db 8643

# Creates /run/docubrowser (-> /var/run/docubrowser) owned by james, used for
# docubrowser.pid by docubrowser.py's _pick_runtime_path()
RuntimeDirectory=docubrowser
RuntimeDirectoryMode=0750

# Creates /var/log/docubrowser owned by james, for docubrowser.log
LogsDirectory=docubrowser
LogsDirectoryMode=0750

StandardOutput=append:/var/log/docubrowser/docubrowser.log
StandardError=append:/var/log/docubrowser/docubrowser.log

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
